[global]
ioengine=libaio
direct=1
runtime=60
time_based
filename=/mnt/openssd/fstest
size=4G
group_reporting
[randwrite_4k]
rw=randwrite
bs=4k
iodepth=32
numjobs=1
stonewall
[randread_4k]
rw=randread
bs=4k
iodepth=32
numjobs=1
stonewall
[seqwrite_128k]
rw=write
bs=128k
iodepth=32
numjobs=1
stonewall
[seqread_128k]
rw=read
bs=128k
iodepth=32
numjobs=1
stonewall
